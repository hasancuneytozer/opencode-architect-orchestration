{
  "$schema": "https://opencode.ai/config.json",

  // ─────────────────────────────────────────────────────────────────────────
  // ORCHESTRA — mimar-merkezli orkestrasyon sistemi
  //
  // Katmanlar:
  //   rol     → .opencode/agents/architect.md + .opencode/agents/crew/*.md
  //   beceri  → .opencode/skills/*/SKILL.md        (iş bölümü, döngü, ders, kadro)
  //   komut   → .opencode/commands/*.md             (/orchestrate /auto /recall /standup /cast)
  //   hafıza  → .opencode/plugins/orchestra/        (otomatik hata yakalama + otonom /loop)
  //   veri    → .opencode/memory/                   (lessons.jsonl, state.json)
  //
  // Roller ve beceriler dosya tabanlıdır: eklemek/çıkarmak = dosya eklemek/silmek.
  // Plugin otomatik keşfedilir (.opencode/plugins/); `plugins` dizisine yazmak
  // iki kez yüklenmesine yol açabilir, o yüzden dokunulmaz.
  // Bu klasörü olduğu gibi başka projeye kopyalarsan sistem tamamen taşınır.
  // ─────────────────────────────────────────────────────────────────────────

  "default_agent": "architect",

  // Yeni oturumların varsayılan modeli. Rol dosyalarındaki `model:` alanı YALNIZCA
  // alt ajanları etkiler; birincil ajanın modeli session'da saklanır ve rol alanı
  // onu ezmeyebilir. Bu satır olmadan yeni session, sunucunun varsayılan modeline
  // (ör. ücretli bir sağlayıcı) düşebilir.
  "model": "opencode/space-bunny-free",

  // Paralel yazma çakışmalarını çözmek için ayrı çalışma ağaçları bu dizine açılır.
  "worktree": {
    "directory": "../.worktrees"
  },

  "permissions": [
    // ─────────────────────────────────────────────────────────────────────────
    // SIRALAMA KURALIDIR. Kurallar yukarıdan aşağı taranır ve **SON eşleşen**
    // kural kazanır: bir yasak, kendisinden SONRA gelen bir joker `allow` ile
    // sessizce ölür. Düzen bu yüzden şudur:
    //
    //   1) joker `allow`lar ÖNCE   → her rol bunları miras alır
    //   2) taban yasaklar SONRA    → sonraki hiçbir kural onları ezmeye kalkamaz
    //   3) orkestrasyon kapıları EN SONDA → kapatılır, mimar kendi
    //      frontmatter'ında yeniden açar (bkz. 3)
    //
    // Tersi (yasak önce, joker allow sonra) taban yasakları öldürürdü.
    // `scripts/permissions.test.mjs` bu sırayı ve kapıları her koşumda kanıtlar.
    // ─────────────────────────────────────────────────────────────────────────

    // ── 1) Genel izinler ─────────────────────────────────────────────────────
    // Otonom çalışma varsayılanı: "bitene kadar" onay istemez. Güvenlik 2. blokta.
    // Daha temkinli kurulum: `shell` satırını "ask" yap.
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },

    // Bu dört eylem yukarıdaki joker listesinde yok; adı ayrı listelenir.
    //   external_directory -> proje kökü/worktree dışındaki her read/edit/write
    //   question            -> kullanıcıya soru sorabilme
    //   execute             -> Code Mode
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "execute", "resource": "*", "effect": "allow" },

    // MCP sunucuları. Sunucu adı olmayan bir MCP aracı bu kalıplara girmez.
    { "action": "shotcut_*", "resource": "*", "effect": "allow" },
    { "action": "blender_*", "resource": "*", "effect": "allow" },
    { "action": "blenderlab_*", "resource": "*", "effect": "allow" },

    // ── 2a) Yıkıcı komutlar ─────────────────────────────────────────────────
    // `*` sıfır karakteri de kapsar: `rm -rf ~*` yalnız `rm -rf ~` değil,
    // `rm -rf ~/Documents` biçimindeki her hedefi de yakalar.
    { "action": "shell", "resource": "rm -rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf C:*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /c/*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf --no-preserve-root*", "effect": "deny" },
    { "action": "shell", "resource": "Remove-Item * -Recurse *", "effect": "deny" },

    // Düz push serbest; uzaktaki geçmişi ezen zorlamalı varyantlar yasak
    // (--force-with-lease de kapsamdadır).
    { "action": "shell", "resource": "git push --force*", "effect": "deny" },
    { "action": "shell", "resource": "git push -f*", "effect": "deny" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "deny" },
    { "action": "shell", "resource": "git clean *", "effect": "deny" },

    // Paket yayımlama geri alınamaz.
    { "action": "shell", "resource": "npm publish*", "effect": "deny" },
    { "action": "shell", "resource": "pnpm publish*", "effect": "deny" },
    { "action": "shell", "resource": "yarn publish*", "effect": "deny" },

    // Uzak betiği indirip çalıştırma. Yorumlayıcı adı Sonda aranır; `| grep sh`
    // gibi borular yanlış eşleşmesin diye sona çivilendi. Spasız varyant `*sh`,
    // bayraklı varyant `-*`; `sh` ve `bash` ailelerinin ikisi de kapalı.
    { "action": "shell", "resource": "*| sh", "effect": "deny" },
    { "action": "shell", "resource": "*| sh -*", "effect": "deny" },
    { "action": "shell", "resource": "*| bash", "effect": "deny" },
    { "action": "shell", "resource": "*| bash -*", "effect": "deny" },
    { "action": "shell", "resource": "*|*sh", "effect": "deny" },
    { "action": "shell", "resource": "*|*sh -*", "effect": "deny" },

    // ── 2b) Sır yasakları ───────────────────────────────────────────────────
    // Yazmakla yetinmek yetmez: OKUMAK da sızıntıdır; `read` ve `edit` için aynı
    // desenler yazılır. Desende `*` yol ayracını da kapsar, `**/` öneği gerekmez.
    // Motor `\` -> `/` normalize eder (her OS'ta) ve Windows'ta harf duyarsızdır.
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.npmrc", "effect": "deny" },
    { "action": "read", "resource": "*.git/config", "effect": "deny" },
    { "action": "read", "resource": "*id_rsa*", "effect": "deny" },

    // Örnek dosyalar istisnası. Bu bir GÜVENLİK GARANTİSİ DEĞİL, tercih:
    // `.env.example|.sample|.template` adlandırması sır içermeme kuralına işaret
    // eder, ama motor adı geçen her dosyanın sır içermediğini doğrulayamaz.
    // Sıralama gereği `*.env.*` deny'si bunları da kapatıyordu; bu istisna
    // dokümantasyon okumasını geri açar. `edit` tarafı kapalı kalır.
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.sample", "effect": "allow" },
    { "action": "read", "resource": "*.env.template", "effect": "allow" },

    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.npmrc", "effect": "deny" },
    { "action": "edit", "resource": "*.git/config", "effect": "deny" },
    { "action": "edit", "resource": "*id_rsa*", "effect": "deny" },

    // ── 2c) Mimari kısıt ─────────────────────────────────────────────────────
    // Yalnızca mimar alt ajan başlatabilir. Aynı desen kuralı: joker `deny`
    // ÖNCE, daraltılmış `allow`lar SONRA.
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "crew/*", "effect": "allow" },
    { "action": "subagent", "resource": "explore", "effect": "allow" },
    { "action": "subagent", "resource": "general", "effect": "allow" },

    // ── 3) Orkestrasyon kapıları — DİZİNİN SONU ─────────────────────────────
    // `orchestra_report`/`orchestra_task` tek yuva olan döngü ve iş paketi
    // durumunu yazar; alt ajan "bitti" bildirirse otonom iş erken kapanır ya da
    // defter mimarın kararını ezmez.
    //
    // Ölçülen ölü kapı: burada `deny` SONRA `allow` joker'ı geliyordu; son
    // eşleşen kural kazandığı için config TEK BAŞINA HİÇBİR ŞEYİ KAPATMIYORDU.
    // Yerleşik rollerde (`build`/`plan`/`explore`/`general`/`summary`/`title`/
    // `compaction`) rol dosyası olmadığı için izin katmanındaki boşluk
    // programatik kapıyı tek koruma yapıyordu.
    //
    // Doğru çözüm config'de joker `allow` yazmamak: `deny` en sonda kalır ve
    // mimar kendi frontmatter'ının EN SONUNDA açık `allow` ile açar (ajan
    // kuralları config'ten sonra birleşir, son eşleşen yine mimarınki olur).
    // Crew rolleri `deny` taşır; rol dosyası olmayan her rol config'teki
    // deny ile kalır.
    //
    // İkinci katman: araç `context.agent`'i denetler; izin boru hattı değişse
    // de programatik kapı yerinde kalır (bkz. tools.ts).
    { "action": "orchestra_report", "resource": "*", "effect": "deny" },
    { "action": "orchestra_task", "resource": "*", "effect": "deny" }
  ],

  "agents": {
    // Mimarlık rolü .opencode/agents/architect.md dosyasında tanımlıdır.
    //
    // DİKKAT: buradaki `agents.<id>` girdisi rol dosyasının TAMAMINI ezer; role
    // dosyasındaki `permissions` uygulanmaz. Bu yüzden bu blokta yalnız `description`
    // vardır. İzin kuralı JSONC'ye taşınmak istenirse rolün frontmatter'ı bozulur.
    //
    // Model stratejisi: TÜM roller opencode/space-bunny-free kullanır — tek model,
    // sıfır maliyet, öngörülebilir davranış. Kademelendirme bilinçli olarak kapalı.
    //
    // Kademelendirmek istersen (muhakeme isteyen rollere güçlü, kalabalık rollere
    // hızlı model), rol dosyalarının `model:` satırını ayrı ayrı değiştir:
    //
    //   architect / crew/analyst / crew/critic            → opencode/longcat-2.5-preview-free
    //   crew/researcher / crew/verifier / crew/curator     → opencode/nemotron-3-ultra-free
    //   crew/maker / crew/operator                          → opencode/mimo-v2.6-flash-free
    //   crew/scout                                          → opencode/nemotron-3.5-lightning-free
    //   crew/scribe                                         → opencode/ling-3.0-flash-fin-free
    //
    // Not: session'da seçili model her zaman rolün modelini ezer. Bu yüzden
    // yukarıdaki `model` satırı yeni oturumların varsayılanını da belirler.
    "architect": {
      "description": "ORKESTRATÖR. Karmaşık işleri böler, crew rollerine paralel devreder, doğrular, hatadan ders çıkarır."
    }
  }
}
