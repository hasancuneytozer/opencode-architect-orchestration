# ── Sunucu ────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=4317
NODE_ENV=development

# ── Veri ──────────────────────────────────────────────────────────────────
# Göreli yollar app/ altına göre çözülür.
SP_DATA_DIR=./data
SP_STORAGE_DIR=./storage
SP_DATABASE_FILE=./data/publisher.db

# ── Güvenlik ──────────────────────────────────────────────────────────────
# 32 bayt, base64. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Bu anahtar olmadan kayıtlı token'lar çözülemez. ÜRETİMDE BUNU KAYBETME.
SP_MASTER_KEY=
# Arayüz oturumu ve ingest anahtarları bununla özetlenir.
SP_ADMIN_PASSWORD=
# Ingest (AI proje çıktıları) istemcileri için: sp_ ile başlayan anahtarlar.
# Anahtar üretmek için: npm run sp -- api-key create <proje>
SP_INGEST_KEYS=

# ── Herkese açık adres ────────────────────────────────────────────────────
# ÜÇ PLATFORMDA DA ZORUNLU DEĞİLDİR — bu 2026-09 itibarıyla doğrulanan bir
# durumdur:
#   Instagram  → resumable upload var (rupload.facebook.com), yerel dosya gider.
#   TikTok     → FILE_UPLOAD ile ikili (chunk) yükleme var.
#   YouTube    → resumable upload var.
# Dolayısıyla video hiçbir platformda herkese açık URL'e çıkmaz.
# Bu alan YALNIZCA arayüze uzaktan (telefondan/başka bilgisayardan) erişmek
# istersen gerekir. Boş bırakırsan arayüz sadece localhost'ta çalışır.
#
#   cloudflared tunnel --url http://127.0.0.1:4317
# Tünel adresi her yeniden başlatmada değişir; buraya yeni adresi yaz.
SP_PUBLIC_BASE_URL=

# ── Günlüğe ───────────────────────────────────────────────────────────────
SP_LOG_LEVEL=info

# ── Sağlayıcı kimlikleri ─────────────────────────────────────────────────
# Üçü de boş olabilir; uygulama "mock" modunda çalışır ve gerçek yayın yapmaz.
SP_META_APP_ID=
SP_META_APP_SECRET=
SP_META_REDIRECT_URI=http://127.0.0.1:4317/api/v1/auth/meta/callback
SP_TIKTOK_CLIENT_KEY=
SP_TIKTOK_CLIENT_SECRET=
SP_TIKTOK_REDIRECT_URI=http://127.0.0.1:4317/api/v1/auth/tiktok/callback
SP_GOOGLE_CLIENT_ID=
SP_GOOGLE_CLIENT_SECRET=
SP_GOOGLE_REDIRECT_URI=http://127.0.0.1:4317/api/v1/auth/youtube/callback

# Kapalıysa (false) medya adresleri özel ağa/özel IP'ye işaret edemez.
SP_ALLOW_PRIVATE_MEDIA_URL=false

# ── Yayın motoru ──────────────────────────────────────────────────────────
# Kaç yayın işi aynı anda çalışabilir (sağlayıcı hız sınırlarını zorlamamak için).
SP_PUBLISH_CONCURRENCY=1
# Zamanlanmış işin kaç saniye gecikmeyle çalması kabul edilir.
SP_SCHEDULER_TICK_MS=15_000
# Yerel saat dilimi; takvim ve "sessiz saat" hesapları bu değeri kullanır.
SP_TIMEZONE=Europe/Istanbul
