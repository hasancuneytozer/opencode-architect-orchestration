node_modules/

# Orchestra hafızası kişiye özeldir; depoya girmez.
# Böylece her yeni klon SIFIR bir hafızayla başlar: sistem kendi hatasından öğrenir,
# senin hatanla değil. Sıfırlamak için dosyayı silmen yeterli.
.opencode/memory/

.worktrees/
*.log
.DS_Store

# Proje-yerel acik kod runtime'i (pinned @opencode paketleri + indirilen Node + ozel hafiza).
# Tamamen bu depoya ait; global kuruluma hicbir sey yazmaz. Silmek runtime'i sifirlar.
.orchestra-runtime/

# Çalışma zamanı çıktıları ve yerel dosyalar. Boilerplate kopyasında bunlar takip edilirse
# projenin git gürültüsü olur; sır olabilecek dosyalar da sessizce commit'e girebilir.
logs/
coverage/
auth.json
.env
.env.*
*.pem
*.key

# Şablon dosyalar istisnadır: örnek dosyalar takip edilebilmeli, gerçek sırlar değil.
!.env.example
!.env.sample
!.env.template

# Windows / macOS çöpleri. `.DS_Store` macOS içindir; Windows'un karşılığı burada.
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# Bağımlılık çözümleme kaydı takip edilmez. `npm install` her kurulumda kendi lock'unu
# üretir; şablonda tutulan bir çözümleme, kopyalanan projeye bu makinenin transitif
# bağımlılıklarını da taşır. Kural olmazsa ilk `npm install` sonrası `git status` kirli
# kalır. Bedeli: "klon → kur → aynı test sonucu" garantisi yoktur.
package-lock.json
